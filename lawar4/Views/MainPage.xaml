<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:lawar4.ViewModels"
             x:Class="lawar4.Views.MainPage"
             x:Name="PageRoot"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource BodyBg}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="42,28,42,60" Spacing="0" MaximumWidthRequest="1180" HorizontalOptions="Center">

                <!-- Command Center Hero Header -->
                <Border Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="0" Margin="0,0,0,16">
                    <Grid HeightRequest="100">
                        <Image Source="command_center_header.png" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                        <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="16,12" BackgroundColor="#E6101417" Stroke="{StaticResource PrimaryBg}" StrokeThickness="1" Padding="12,6" StrokeShape="RoundRectangle 3">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="app_launcher.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                <Label Text="[ RADAR HQ / TACTICAL DESK ]" Style="{StaticResource Eyebrow}" TextColor="{StaticResource PrimaryBg}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Topbar -->
                <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="[ COMMAND CENTER / WEEKLY OPERATIONS ]" Style="{StaticResource Eyebrow}" />
                        <Label Text="LAST WAR: SURVIVAL DESK" Style="{StaticResource H1}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" VerticalOptions="End" BackgroundColor="#1D2630" Stroke="{StaticResource ConnReady}" StrokeThickness="1" Padding="10,6" StrokeShape="RoundRectangle 3">
                        <Label Style="{StaticResource FieldLabel}" Text="[ STATUS: ONLINE · RADAR READY ]" TextColor="{StaticResource ConnReady}" />
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource LineColor}" />

                <!-- Steps: active step (orange bottom accent + orange text) is driven by the
                     ViewModel's existing IsSettings/IsRoster/.../IsExport step flags via DataTrigger,
                     the same flags the step content panels use for IsVisible. -->
                <HorizontalStackLayout Spacing="6" Padding="0,20,0,26">
                    <VerticalStackLayout Spacing="0">
                        <Button Text="01 SETUP" Style="{StaticResource CompactButton}" Command="{Binding GoToCommand}" CommandParameter="0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSettings}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Style="{StaticResource NavStepAccent}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding IsSettings}" Value="True">
                                    <Setter Property="Color" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Button Text="02 ROSTER" Style="{StaticResource CompactButton}" Command="{Binding GoToCommand}" CommandParameter="1">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsRoster}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Style="{StaticResource NavStepAccent}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding IsRoster}" Value="True">
                                    <Setter Property="Color" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Button Text="03 RECON" Style="{StaticResource CompactButton}" Command="{Binding GoToCommand}" CommandParameter="2">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsScreenshots}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Style="{StaticResource NavStepAccent}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding IsScreenshots}" Value="True">
                                    <Setter Property="Color" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Button Text="04 VERIFY" Style="{StaticResource CompactButton}" Command="{Binding GoToCommand}" CommandParameter="3">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsReview}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Style="{StaticResource NavStepAccent}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding IsReview}" Value="True">
                                    <Setter Property="Color" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Button Text="05 DEBRIEF" Style="{StaticResource CompactButton}" Command="{Binding GoToCommand}" CommandParameter="4">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsExport}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <BoxView Style="{StaticResource NavStepAccent}">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding IsExport}" Value="True">
                                    <Setter Property="Color" Value="{StaticResource PrimaryBg}" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- ===== Settings ===== -->
                <VerticalStackLayout IsVisible="{Binding IsSettings}" Spacing="16">
                    <Label Text="[ OP-01 / ENDPOINT CONFIG ]" Style="{StaticResource Eyebrow}" />
                    <Label Text="Point the extractor at your vision model." Style="{StaticResource H2}" />
                    <Label Text="Configure the LLM provider and enter your API key. Credentials are stored securely via encrypted vault." Style="{StaticResource Body}" />

                    <Border Style="{StaticResource WorkflowCard}">
                        <VerticalStackLayout Spacing="15">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="LLM PROVIDER" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Picker Style="{StaticResource FieldPicker}" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="BASE URL" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Entry Style="{StaticResource Field}" Text="{Binding BaseUrl}" IsEnabled="{Binding IsBaseUrlEditable}" Placeholder="https://api.openai.com/v1" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="MODEL" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Entry x:Name="ModelEntry" Style="{StaticResource Field}" Text="{Binding Model}" Placeholder="e.g. gemini-3.5-flash-lite or custom model" Focused="ModelEntry_Focused" Unfocused="ModelEntry_Unfocused" />
                                </Border>
                                <Border IsVisible="{Binding ShowModelSuggestions}" BackgroundColor="{StaticResource PanelBg}" Stroke="{StaticResource InputLine}" StrokeThickness="1" Padding="0" StrokeShape="RoundRectangle 3" MaximumHeightRequest="160">
                                    <CollectionView ItemsSource="{Binding FilteredModels}" SelectionMode="Single" SelectedItem="{Binding SelectedModelSuggestion}">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid Padding="12,8">
                                                    <Label Text="{Binding .}" Style="{StaticResource Body}" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Border>
                            </VerticalStackLayout>
                            <!-- API Style + RPM are compact values, so they share a row (2:1 ratio; star columns keep it usable if the card shrinks below 720). -->
                            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="API STYLE" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputShell}">
                                        <Picker Style="{StaticResource FieldPicker}" ItemsSource="{Binding ApiStyles}" SelectedItem="{Binding ApiStyle}" IsEnabled="{Binding IsApiStyleEditable}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="REQUESTS / MIN" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputShell}">
                                        <Entry Style="{StaticResource Field}" Text="{Binding RequestsPerMinute}" Keyboard="Numeric" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <HorizontalStackLayout Spacing="10" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding UseCache}" />
                                <Label Text="Reuse cached extractions (skips repeat API calls)" Style="{StaticResource Body}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding ApiKeyFieldLabel}" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Entry Style="{StaticResource Field}" Text="{Binding ApiKey}" IsPassword="True" Placeholder="Paste your API key to store it securely" />
                                </Border>
                                <Label Text="{Binding ApiKeyStatus}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                            <Button Text="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Margin="0,4,0,0" />
                            <Label Text="{Binding SettingsMessage}" Style="{StaticResource Body}" IsVisible="{Binding SettingsMessage, Converter={StaticResource NotEmpty}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== Roster ===== -->
                <VerticalStackLayout IsVisible="{Binding IsRoster}" Spacing="16">
                    <Label Text="[ OP-02 / SQUAD REGISTRY ]" Style="{StaticResource Eyebrow}" />
                    <Label Text="Import the alliance roster." Style="{StaticResource H2}" />
                    <Label Text="Load the active squad member roster before executing recon extraction." Style="{StaticResource Body}" />

                    <Border Style="{StaticResource WorkflowCard}">
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4" BackgroundColor="{StaticResource ToggleBg}" Padding="4">
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Button Text="Local Excel" Style="{StaticResource SegmentButton}" HorizontalOptions="Fill" Command="{Binding SelectXlsxSourceCommand}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsXlsxSource}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBg}" />
                                                <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <BoxView Style="{StaticResource SegmentAccent}">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsXlsxSource}" Value="True">
                                                <Setter Property="Color" Value="{StaticResource MatchedBorder}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Button Text="Google Sheet URL" Style="{StaticResource SegmentButton}" HorizontalOptions="Fill" Command="{Binding SelectGoogleSourceCommand}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsXlsxSource}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBg}" />
                                                <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <BoxView Style="{StaticResource SegmentAccent}">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsXlsxSource}" Value="False">
                                                <Setter Property="Color" Value="{StaticResource MatchedBorder}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="SOURCE" Style="{StaticResource FieldLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Border Style="{StaticResource InputShell}">
                                        <Entry Style="{StaticResource Field}" Text="{Binding RosterInput}" Placeholder="Path to .xlsx or Google Sheet URL" />
                                    </Border>
                                    <Button Grid.Column="1" Text="Browse" Style="{StaticResource CompactButton}" Command="{Binding BrowseRosterCommand}" IsVisible="{Binding IsXlsxSource}" />
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="WORKSHEET NAME" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Entry Style="{StaticResource Field}" Text="{Binding SheetName}" Placeholder="Members" />
                                </Border>
                            </VerticalStackLayout>
                            <Button Text="Load roster" Style="{StaticResource PrimaryButton}" Command="{Binding LoadRosterCommand}" />
                            <ActivityIndicator IsRunning="{Binding RosterBusy}" IsVisible="{Binding RosterBusy}" HorizontalOptions="Start" />
                            <Label Text="{Binding RosterMessage}" Style="{StaticResource Body}" IsVisible="{Binding RosterMessage, Converter={StaticResource NotEmpty}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RosterWarnings}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource WarningText}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== Screenshots ===== -->
                <VerticalStackLayout IsVisible="{Binding IsScreenshots}" Spacing="16">
                    <Label Text="[ OP-03 / RECON CAPTURES ]" Style="{StaticResource Eyebrow}" />
                    <Label Text="Ingest weekly leaderboard screenshots." Style="{StaticResource H2}" />
                    <Label Text="Add leaderboard screenshots to queue, then trigger vision extraction." Style="{StaticResource Body}" />

                    <Border Style="{StaticResource WorkflowCard}">
                        <VerticalStackLayout Spacing="18">

                            <!-- Primary interaction: import surface (real drag-and-drop on Windows; buttons always work) -->
                            <Border x:Name="DropZone" Loaded="DropZone_Loaded"
                                    BackgroundColor="{StaticResource ToggleBg}" Stroke="{StaticResource InputLine}"
                                    StrokeThickness="2" StrokeDashArray="6,4" StrokeShape="RoundRectangle 6" Padding="24,32">
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Label Text="[ DROP SCREENSHOTS HERE ]" Style="{StaticResource Eyebrow}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                    <Label Text="PNG · JPG · JPEG · WEBP · GIF" Style="{StaticResource FieldLabel}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" WidthRequest="360" Margin="0,10,0,0">
                                        <Button Grid.Column="0" Text="Choose screenshots" Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill" Command="{Binding ChooseScreenshotsCommand}" />
                                        <Button Grid.Column="1" Text="Choose folder" Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill" Command="{Binding ChooseFolderCommand}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Review: queued screenshots -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="QUEUED SCREENSHOTS" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ScreenshotQueue.Count, StringFormat='{0} screenshots queued'}" Style="{StaticResource Body}" VerticalOptions="Center"
                                       IsVisible="{Binding ScreenshotQueue.Count, Converter={StaticResource CountToBool}}" />
                            </Grid>
                            <ScrollView MaximumHeightRequest="140" IsVisible="{Binding ScreenshotQueue.Count, Converter={StaticResource CountToBool}}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ScreenshotQueue}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}" FontFamily="Consolas" FontSize="12" TextColor="{StaticResource Muted2}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>
                            <Label Text="No screenshots queued yet. Choose screenshots or a folder above." Style="{StaticResource Body}"
                                   IsVisible="{Binding ScreenshotQueue.Count, Converter={StaticResource CountToBool}, ConverterParameter=invert}" />

                            <BoxView HeightRequest="1" Color="{StaticResource LineColor}" />

                            <!-- Extract: primary action -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="{Binding ExtractButtonText}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Fill"
                                        Command="{Binding ExtractCommand}" IsEnabled="{Binding IsExtracting, Converter={StaticResource Invert}}" />
                                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelExtractionCommand}" IsVisible="{Binding IsExtracting}" />
                            </Grid>
                            <ProgressBar Progress="{Binding ExtractionProgress}" IsVisible="{Binding IsExtracting}" ProgressColor="{StaticResource TextColor}" />
                            <Label Text="{Binding ExtractionMessage}" Style="{StaticResource Body}" IsVisible="{Binding ExtractionMessage, Converter={StaticResource NotEmpty}}" />

                            <!-- Secondary/advanced: manual absolute paths for power users -->
                            <BoxView HeightRequest="1" Color="{StaticResource LineColor}" />
                            <Button Text="{Binding ManualPathsToggleLabel}" Style="{StaticResource CompactButton}" HorizontalOptions="Start" Command="{Binding ToggleManualPathsCommand}" />
                            <VerticalStackLayout IsVisible="{Binding ShowManualPaths}" Spacing="10">
                                <Label Text="MANUAL FILE PATHS" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}" Padding="12,8">
                                    <Editor Text="{Binding PastedPaths}" Placeholder="Paste one absolute path per line" HeightRequest="90" BackgroundColor="Transparent" TextColor="{StaticResource TextColor}" />
                                </Border>
                                <Button Text="Add screenshots" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Command="{Binding AddScreenshotsCommand}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== Review ===== -->
                <VerticalStackLayout IsVisible="{Binding IsReview}" Spacing="16">
                    <Label Text="[ OP-04 / TARGET VERIFICATION ]" Style="{StaticResource Eyebrow}" />
                    <Label Text="Resolve unassigned targets &amp; squad aliases." Style="{StaticResource H2}" />

                    <!-- Verify results: narrower than the page/header so rows stay scannable (see VerifyListWidth). -->
                    <VerticalStackLayout Style="{StaticResource VerifyListWidth}" Spacing="16">
                        <!-- Extraction/model diagnostics: collapsed-by-default summary so it stays
                             secondary to the Verify rows below (the actionable, per-observation
                             review work). Left accent strip mirrors the ObservationRow pattern. -->
                        <Border Style="{StaticResource Card}" Padding="0" IsVisible="{Binding Issues.Count, Converter={StaticResource CountToBool}}">
                            <Grid ColumnDefinitions="4,*">
                                <BoxView Grid.Column="0" BackgroundColor="{StaticResource WarningText}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                            <Label Text="[ WARN ]" FontFamily="Consolas" FontSize="11" CharacterSpacing="1.0" FontAttributes="Bold" TextColor="{StaticResource WarningText}" VerticalOptions="Center" />
                                            <Label Text="{Binding Issues.Count, StringFormat='{0} extraction warnings'}" FontSize="13" TextColor="{StaticResource TextColor}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Button Grid.Column="1" Text="{Binding IssuesToggleLabel}" Style="{StaticResource CompactButton}" Command="{Binding ToggleIssuesCommand}" VerticalOptions="Center" />
                                    </Grid>
                                    <ScrollView IsVisible="{Binding ShowIssues}" MaximumHeightRequest="260">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Issues}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Label Text="{Binding .}" FontFamily="Consolas" FontSize="12" TextColor="{StaticResource Muted2}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Observations}" Spacing="9">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ObservationItem">
                                    <Border Style="{StaticResource ObservationRow}">
                                        <Grid ColumnDefinitions="4,Auto,*,Auto,Auto" MinimumHeightRequest="72">
                                            <!-- Status accent: quiet green strip for matched rows, orange/red for rows needing review (ObservationRow style adds the border color on top for unresolved rows). -->
                                            <BoxView Grid.Column="0" BackgroundColor="{Binding AccentColor}" />
                                            <Image Grid.Column="1" Source="{Binding StatusIcon}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" Margin="12,13,0,13" />
                                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" Margin="12,13,10,13">
                                                <Label Text="{Binding Header}" Style="{StaticResource Eyebrow}" />
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColor}" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Muted2}" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="3" Text="{Binding Matched}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextColor}"
                                                   VerticalOptions="Center" Margin="0,0,10,0" LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Button Grid.Column="4" Text="{Binding AssignLabel}" Style="{StaticResource CompactButton}" VerticalOptions="Center" Margin="0,0,12,0"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenAssignCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="No observations in queue. Ingest screenshots to populate target list." Style="{StaticResource Body}"
                               IsVisible="{Binding Observations.Count, Converter={StaticResource CountToBool}, ConverterParameter=invert}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== Export ===== -->
                <VerticalStackLayout IsVisible="{Binding IsExport}" Spacing="16">
                    <Label Text="[ OP-05 / INTEL DEBRIEF ]" Style="{StaticResource Eyebrow}" />
                    <Label Text="Compile weekly score summary." Style="{StaticResource H2}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource Card}" MinimumWidthRequest="180" HorizontalOptions="Fill">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Image Source="app_launcher.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="SQUAD MEMBERS" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding MemberCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" MinimumWidthRequest="180" HorizontalOptions="Fill">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Image Source="matched_status_badge.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="OBSERVATIONS" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding ObservationCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" MinimumWidthRequest="180" HorizontalOptions="Fill">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Image Source="unmatched_target_skull_badge.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="UNRESOLVED TARGETS" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding UnmatchedCount}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource ErrorText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Button Text="Export workbook" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" />
                    <Label Text="{Binding ExportMessage}" Style="{StaticResource Body}" IsVisible="{Binding ExportMessage, Converter={StaticResource NotEmpty}}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Assign overlay ===== -->
        <Grid IsVisible="{Binding AssignVisible}" BackgroundColor="#E60B0E11">
            <Border BackgroundColor="{StaticResource PanelBg}" Stroke="{StaticResource PrimaryBg}" StrokeThickness="2"
                    Padding="24" WidthRequest="520" MaximumHeightRequest="640"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="[ MANUAL SQUAD ASSIGNMENT ]" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding AssignTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                        <Label Text="{Binding AssignSubtitle}" Style="{StaticResource Body}" />

                        <Label Text="TARGET SUGGESTIONS" Style="{StaticResource FieldLabel}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlternativeItem">
                                    <Button Text="{Binding Label}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AssignMemberCommand}"
                                            CommandParameter="{Binding MemberId}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="SEARCH MEMBERS" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry Style="{StaticResource Field}" Text="{Binding MemberSearch}" Placeholder="Search members..." />
                        </Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SearchResults}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MemberRow">
                                    <Button Text="{Binding Display}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AssignMemberCommand}"
                                            CommandParameter="{Binding Id}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <CheckBox IsChecked="{Binding RememberAlias}" />
                            <Label Text="Remember as alias" Style="{StaticResource Body}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CloseAssignCommand}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
